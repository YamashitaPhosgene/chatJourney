{
  "info": {
    "_postman_id": "talker-collection-uuid",
    "name": "Talker API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TalkSession",
      "item": [
        {
          "name": "GetTalkSessionList",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "token {{chatjourney_token}}", "type": "text"}
            ],
            "url": {
              "raw": "http://127.0.0.1:8000/api/talk_sessions/",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8000",
              "path": ["api", "talk_sessions", ""]
            }
          }
        },
        {
          "name": "GetTalkSessionDetail",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "token {{chatjourney_token}}", "type": "text"}
            ],
            "url": {
              "raw": "http://127.0.0.1:8000/api/talk_sessions/1/",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8000",
              "path": ["api", "talk_sessions", "1", ""]
            }
          }
        },
        {
          "name": "ChatWithSession",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "token {{chatjourney_token}}", "type": "text"},
              {"key": "Content-Type", "value": "application/json", "type": "text"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"我想去北京旅游\"\n}"
            },
            "url": {
              "raw": "http://127.0.0.1:8000/api/talk_sessions/1/chat/",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8000",
              "path": ["api", "talk_sessions", "1", "chat", ""]
            }
          }
        },
        {
          "name": "RemoveHistoryFromSession",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "token {{chatjourney_token}}", "type": "text"},
              {"key": "Content-Type", "value": "application/json", "type": "text"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"index\": 2\n}"
            },
            "url": {
              "raw": "http://127.0.0.1:8000/api/talk_sessions/1/remove_history/",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8000",
              "path": ["api", "talk_sessions", "1", "remove_history", ""]
            }
          }
        },
        {
          "name": "DeleteTalkSession",
          "request": {
            "method": "DELETE",
            "header": [
              {"key": "Authorization", "value": "token {{chatjourney_token}}", "type": "text"}
            ],
            "url": {
              "raw": "http://127.0.0.1:8000/api/talk_sessions/1/",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8000",
              "path": ["api", "talk_sessions", "1", ""]
            }
          }
        }
      ]
    }
  ]
} 